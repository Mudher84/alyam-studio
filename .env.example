# Public configuration
VITE_API_URL=

# Note: The Gemini API Key must remain server-side and should not be prefixed with VITE_
GEMINI_API_KEY=

# Firebase configuration (if using Firebase client SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS Configuration (Optional: for Contact Form emails)
# Get these at https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
 
# Custom Media Server (e.g. media.wana84.com)
VITE_MEDIA_API_ENDPOINT=
